# Copy to .env.local and fill in real values. Never commit .env.local.
# For local development, `npm run db:start` prints the local Supabase values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false   # true once Google OAuth is configured in Supabase
SUPABASE_SECRET_KEY=                  # server only, never expose to the browser

# AI (Phase 2)
ANTHROPIC_API_KEY=                    # server only
AI_MODEL_PLANNER=
AI_MODEL_LIGHT=

# Nutrition data (Phase 2; optional, bulk import needs none)
FDC_API_KEY=

# Billing (Phase 3; choose one provider)
BILLING_PROVIDER=                     # paddle | stripe
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PRICE_MONTHLY_ID=
BILLING_PRICE_YEARLY_ID=

# Analytics and monitoring (Phase 4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=
