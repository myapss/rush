# Copy to .env.local and fill in real values. Never commit .env.local.
# For local development, `npm run db:start` prints the local Supabase values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false   # true once Google OAuth is configured in Supabase
SUPABASE_SECRET_KEY=                  # server only, never expose to the browser

# AI (Phase 2)
ANTHROPIC_API_KEY=                    # server only
AI_MODEL_PLANNER=                     # default claude-opus-5-5
AI_MODEL_RECIPES=                     # default claude-opus-5-5

# Nutrition data (Phase 2; optional, bulk import needs none)
FDC_API_KEY=

# Billing: Paddle (Phase 3). Use sandbox values until you go live.
PADDLE_ENVIRONMENT=sandbox            # sandbox | production
PADDLE_API_KEY=                       # server only (Paddle → Developer tools → Authentication)
PADDLE_WEBHOOK_SECRET=                # server only (secret of the notification destination)
PADDLE_PRICE_MONTHLY_ID=              # pri_... for $9.99/month
PADDLE_PRICE_YEARLY_ID=               # pri_... for $59.99/year
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=      # client-side token (safe to expose), test_... or live_...

# Analytics and monitoring (Phase 4). All optional; features stay off when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=        # G-XXXXXXX; loaded only after cookie consent, public pages only
SENTRY_DSN=                           # server error reports
NEXT_PUBLIC_SENTRY_DSN=               # browser error reports (same DSN)
