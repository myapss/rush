# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose to the browser

# AI
ANTHROPIC_API_KEY=                    # server only
AI_MODEL_PLANNER=
AI_MODEL_LIGHT=

# Nutrition data
FDC_API_KEY=                          # optional; bulk import needs none

# Billing (choose one provider)
BILLING_PROVIDER=                     # paddle | stripe
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PRICE_MONTHLY_ID=
BILLING_PRICE_YEARLY_ID=

# Site and analytics
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=
